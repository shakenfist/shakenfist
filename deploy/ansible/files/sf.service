[Unit]
Description=Shaken Fist {{ item }} daemon
After=multi-user.target
PartOf=sf.target
ReloadPropagatedFrom=sf.target

[Service]
Type=simple
User=root
Group=root

EnvironmentFile=/etc/sf/config
ExecStartPre=/bin/sh -c '/srv/shakenfist/venv/bin/sf-ctl verify-config'
ExecStart=/bin/sh -c '/srv/shakenfist/venv/bin/sf-{{ item }}'
ExecStop=/bin/sh -c '/srv/shakenfist/venv/bin/sf-ctl stop {{ item }}'

Restart=on-failure
RestartSec=5

# Note that this _does_not_ create the PID file, it merely causes it to be
# cleaned up when the unit stops. The PID file is created in the main() for
# each daemon instead.
PIDFile=/run/sf-{{ item }}.pid

[Install]
WantedBy=sf.target
