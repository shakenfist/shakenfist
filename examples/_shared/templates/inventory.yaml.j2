---
# /etc/sf/inventory.yaml -- a plain ansible inventory describing the cluster
# topology, written once per deploy by the example playbook.
#
# This file is consumed by the client-python functional-tests CI, which scp's
# it off a node and uses it as the ansible inventory for the native-module
# tests. It reproduces the structure of the legacy
# roles/primary/templates/inventory.yaml, but the primary node is gone, so the
# legacy "primary_node" group is dropped.
#
# It is rendered from variables the playbook computed from inventory groups
# (the playbook is the only layer allowed to read groups): all_mesh_hosts (a
# name->mesh-IP map of every host) and the per-capability host-name lists
# inventory_hypervisors / inventory_network_nodes / inventory_database_nodes /
# inventory_storage_nodes.
all:
  hosts:
{% for name, mesh_ip in all_mesh_hosts.items() %}
    {{ name }}:
      ansible_host: {{ mesh_ip }}
{% endfor %}

  children:
    hypervisors:
      hosts:
{% for name in inventory_hypervisors %}
        {{ name }}:
{% endfor %}

    etcd:
      hosts:
{% for name in inventory_database_nodes %}
        {{ name }}:
{% endfor %}

    network:
      hosts:
{% for name in inventory_network_nodes %}
        {{ name }}:
{% endfor %}

    storage:
      hosts:
{% for name in inventory_storage_nodes %}
        {{ name }}:
{% endfor %}
