[Unit]
Description=Shaken Fist API daemon
After=sf-privexec.service
After=sf-nodelock.service
After=sf-database.service
Before=sf-sentinel-last.service
PartOf=sf.target
ReloadPropagatedFrom=sf.target

[Service]
Type=simple
User=root
Group=root
# On SIGTERM sf-api drains: it flips /readyz to 503, keeps serving for
# API_DRAIN_GRACE (default 25s) so the load balancer drops this node, then
# gunicorn finishes in-flight requests within --graceful-timeout (30s).
# TimeoutStopSec must exceed API_DRAIN_GRACE + graceful_timeout + a margin,
# or systemd would SIGKILL the worker mid-drain.
TimeoutStopSec=70s
SuccessExitStatus=SIGTERM 143
RestartPreventExitStatus=SIGTERM
RuntimeDirectory=sf
RuntimeDirectoryPreserve=yes

EnvironmentFile=/etc/sf/config
ExecStartPre=/bin/sh -c '/srv/shakenfist/venv/bin/sf-ctl verify-config'
ExecStartPre=/bin/sh -c 'rm -f /run/sf/gunicorn.pid'
ExecStart=/bin/sh -c '/srv/shakenfist/venv/bin/gunicorn --workers 5 --bind 0.0.0.0:13000 --log-syslog --log-syslog-prefix sf --timeout 300 --graceful-timeout 30 --name "sf-api" --pid /run/sf/gunicorn.pid --config python:shakenfist.external_api.gunicorn_config --preload shakenfist.external_api.app:app'

Restart=on-failure
RestartSec=5

[Install]
WantedBy=sf.target
