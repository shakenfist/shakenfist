[Unit]
Description=Shaken Fist API daemon
After=sf-privexec.service
After=sf-nodelock.service
After=sf-database.service
Before=sf-sentinel-last.service
# The listening socket is sf-api.socket's (see the comment there). Requires
# also means stopping or restarting the socket does the same to sf-api.
Requires=sf-api.socket
After=sf-api.socket
PartOf=sf.target
ReloadPropagatedFrom=sf.target

[Service]
Type=simple
User=root
Group=root
# On SIGTERM sf-api drains: the worker flips /readyz to 503 immediately (so the
# load balancer drops this node), then keeps serving for API_DRAIN_GRACE (25s)
# before it calls gunicorn's graceful shutdown. Note the windows OVERLAP, they
# do not stack: gunicorn's master starts its --graceful-timeout countdown at
# SIGTERM (t=0), not when the worker finally shuts down, and SIGKILLs workers at
# that deadline regardless. So in-flight requests get (graceful_timeout -
# API_DRAIN_GRACE) to finish after the drain. graceful_timeout is therefore set
# to API_DRAIN_GRACE + an in-flight completion budget (25 + 30 = 55s, below), and
# TimeoutStopSec must exceed graceful_timeout so systemd does not SIGKILL the
# master mid-shutdown.
TimeoutStopSec=70s
SuccessExitStatus=SIGTERM 143
RestartPreventExitStatus=SIGTERM
RuntimeDirectory=sf
RuntimeDirectoryPreserve=yes

EnvironmentFile=/etc/sf/config
ExecStartPre=/bin/sh -c '/srv/shakenfist/venv/bin/sf-ctl verify-config'
ExecStartPre=/bin/sh -c 'rm -f /run/sf/gunicorn.pid'
# exec, so gunicorn keeps the pid systemd started: gunicorn uses the socket
# systemd passes only when LISTEN_PID is its own pid, and otherwise falls back to
# binding --bind itself, which fails while sf-api.socket holds the port.
ExecStart=/bin/sh -c 'exec /srv/shakenfist/venv/bin/gunicorn --workers 5 --bind 0.0.0.0:13000 --timeout 300 --graceful-timeout 55 --name "sf-api" --pid /run/sf/gunicorn.pid --config python:shakenfist.external_api.gunicorn_config --preload shakenfist.external_api.app:app'

Restart=on-failure
RestartSec=5

[Install]
WantedBy=sf.target
