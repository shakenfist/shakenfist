# Kerbside's daemon, which scrapes its sources and supervises the SPICE proxy
# (kerbside-proxy) as a child. Written by the shakenfist.shakenfist kerbside
# role.
#
# Wanted by multi-user.target, and deliberately not by Shaken Fist's own
# target unit: on a host which is also a Shaken Fist node, the node role
# isolates that target, which keeps running every unit multi-user.target wants
# (the target requires multi-user.target) and stops every other.
[Unit]
Description=Kerbside VDI console proxy daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ kerbside_user }}
Group={{ kerbside_group }}
WorkingDirectory={{ kerbside_state_dir }}

# The daemon creates its API socket under /run/kerbside, which only root may
# create; systemd creates it for the service user.
RuntimeDirectory=kerbside

# Authoritative: Kerbside fails rather than falling back to another binary if
# this is not executable.
Environment=KERBSIDE_PROXY_BIN={{ kerbside_venv }}/bin/kerbside-proxy

ExecStart={{ kerbside_venv }}/bin/kerbside daemon run

# On SIGTERM the daemon stops the proxy itself, allowing it 15 seconds to drain
# before killing it. mixed sends SIGTERM to the daemon alone, so the proxy is
# not also signalled directly, which the daemon would log as its child dying.
# Anything left at TimeoutStopSec is killed.
KillMode=mixed
TimeoutStopSec=30

# always rather than on-failure: Kerbside exits 0 on a configuration it cannot
# read (kerbside#313), and it never exits 0 on purpose.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
