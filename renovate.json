{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gitAuthor": "shakenfist-bot <bot@shakenfist.com>",
  "dependencyDashboard": true,
  "assignees": [
    "mikalstill"
  ],
  "schedule": [
    "after 9pm"
  ],
  "packageRules": [
    {
      "description": "Automatically merge minor and patch-level updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": false
    },
    {
      "description": "Group pydantic updates together",
      "groupName": "pydantic",
      "matchPackageNames": [
        "/pydantic/"
      ]
    },
    {
      "description": "Group grpcio updates together",
      "groupName": "grpcio",
      "matchPackageNames": [
        "/grpcio/",
        "/protobuf/"
      ]
    },
    {
      "description": "Group things entangled with wraps",
      "groupName": "entangled-wraps",
      "matchPackageNames": [
        "/wraps/",
        "/iters/",
        "/async-extensions/"
      ]
    },
    {
      "description": "Group zope updates together",
      "groupName": "zope",
      "matchPackageNames": [
        "zope.event",
        "zope.interface"
      ]
    },
    {
      "description": "Group gunicorn updates together, as it is pinned both as a direct and indirect dependency",
      "groupName": "gunicorn",
      "matchPackageNames": [
        "/gunicorn/"
      ]
    }
  ],
  "minimumReleaseAge": "3 days",
  "rollbackPrs": true
}
